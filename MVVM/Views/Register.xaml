<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MVVM.Views.Register"
             Title="Register">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="10">

            <Label Text="Welcome To MuscleUp! Create an account"
                   FontSize="28"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   Margin="0,20,0,20" />

            <Label Text="Enter your new username:" />

            <Entry Placeholder="Username"
                   Text="{Binding UserName, Mode=TwoWay}" />

            <Label Text="{Binding UserNameError}"
                   TextColor="Red" />

            <Label Text="Enter your email:" />

            <Entry Placeholder="Email"
                   Keyboard="Email"
                   Text="{Binding Email, Mode=TwoWay}" />

            <Label Text="{Binding EmailError}"
                   TextColor="Red" />

            <Label Text="Enter your new password:" />

            <Entry Placeholder="Password"
                   IsPassword="True"
                   Text="{Binding Password, Mode=TwoWay}" />

            <Label Text="{Binding PasswordError}"
                   TextColor="Red" />

            <Label Text="Confirm password:" />

            <Entry Placeholder="Confirm Password"
                   IsPassword="True"
                   Text="{Binding ConfirmPassword, Mode=TwoWay}" />

            <Label Text="{Binding ConfirmPasswordError}"
                   TextColor="Red" />

            <Label Text="Enter your birthday:" />

            <DatePicker Date="{Binding DateOfBirth, Mode=TwoWay}" />

            <Label Text="{Binding DateOfBirthError}"
                   TextColor="Red" />

            <Label Text="Already have an account? Log In"
                   TextColor="Blue"
                   HorizontalOptions="Center">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer
                        Command="{Binding LoginCommand}" />
                </Label.GestureRecognizers>
            </Label>

            <Button Text="Register"
                    Command="{Binding RegisterCommand}" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
